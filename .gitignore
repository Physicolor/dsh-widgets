node_modules/
*.tsbuildinfo
*.log
.DS_Store

# Private design workspace (cover/poster generator). Local-only: kept out of
# the public repo on purpose - edit freely, git will never show it as dirty.
docs/poster/

# Runtime verification receipts (regenerated on each run; not source).
docs/*-result.json
docs/backup/

# One-off CDP investigation probes from the 2026-09-17 rail / turn-navigator
# incident. Local-only: the durable assertions live in
# docs/verify-report3/scripts/, the receipts in docs/verify-report3/, and the
# written record in docs/verify-report3/FIX-2026-09-17.md.
#
# The 2026-09-19 pass added scripts/diag-auth-lib.cjs: `dsh web` gates the GUI
# behind a signed cookie minted from a per-process launch token, so a fresh
# headless browser only ever sees the 401 page. The signing secret is persisted
# in $DSH_HOME/.credentials.yaml, so a probe can mint its own local cookie and
# drive the real GUI. Local-only by design.
scripts/diag-*.cjs
scripts/_scan-*.cjs

# Probe screenshots (state evidence for a fix, not part of the published docs).
docs/probe-*.png

# Scratch files used to assemble the docs in a release pass.
.tmp-*

# Live probe artefacts (screenshots + jsonl) from the rail verification runs.
.probe-rail/

